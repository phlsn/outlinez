#!/bin/bash
# Startprogramm der Outlinez.app. Laufzeitumgebung und Modelle liegen außerhalb des
# App-Pakets in ~/Library/Application Support/Outlinez (das Paket selbst bleibt unverändert).
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
DATA="$HOME/Library/Application Support/Outlinez"
mkdir -p "$DATA"

export HF_HOME="$DATA/models"
export UV_PYTHON_DOWNLOADS=never
export OUTLINEZ_LOG=1
export PYTHONPYCACHEPREFIX="$DATA/pycache"  # nichts ins signierte App-Paket schreiben

# Ersteinrichtung bzw. nach einem Update: Pakete und Modelle laden (mit Fortschrittsfenster)
if [ "$(cat "$DATA/venv/.outlinez-version" 2>/dev/null)" != "$(cat "$RES/VERSION")" ]; then
    "$RES/python/bin/python3" "$RES/app/firstrun.py" "$RES" "$DATA" || exit 1
fi

export HF_HUB_OFFLINE=1  # Modelle sind vollständig da
cd "$RES/app"
exec "$DATA/venv/bin/python" "$RES/app/app.py"
